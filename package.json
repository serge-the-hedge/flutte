{
	"name": "blabla",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"next-themes": "^0.4.6",
			"convex": "^1.45.0",
			"better-auth": "1.6.25",
			"@convex-dev/better-auth": "^0.12.5",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"build:vercel": "bun scripts/vercel-build.ts",
		"lint": "biome check --error-on-warnings .",
		"check-types": "turbo run check-types",
		"test": "bun run test:agent-kit && turbo run test",
		"check": "bun run lint && bun run check-types && bun run test && bun run build",
		"check:fix": "biome check --write .",
		"prototype:strings": "bun run --cwd apps/web dev --host 127.0.0.1 --port 3017 --strictPort --open /prototype-strings.html?variant=A",
		"dev:web": "turbo run dev -F web",
		"dev:server": "turbo run dev -F @blabla/backend",
		"dev:setup": "turbo run dev:setup -F @blabla/backend",
		"blabla": "dart run cli/bin/blabla.dart",
		"test:agent-kit": "tsc -p tsconfig.agent-kit.json && node --test tests/agent-kit-*.test.mjs"
	},
	"dependencies": {
		"@blabla/env": "workspace:*",
		"dotenv": "^17.4.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@blabla/config": "workspace:*",
		"@types/node": "^24.13.3",
		"turbo": "^2.10.6",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.13"
}
