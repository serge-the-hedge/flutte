{
	"name": "blabla",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@convex-dev/better-auth": "^0.12.5",
			"@types/bun": "^1.4.2",
			"@types/node": "^24.19.1",
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0",
			"better-auth": "1.6.33",
			"convex": "^1.46.0",
			"dotenv": "^18.0.5",
			"lucide-react": "^1.52.0",
			"next-themes": "^0.4.6",
			"react": "^19.3.0",
			"react-dom": "^19.3.0",
			"sonner": "^2.0.8",
			"tailwindcss": "^4.3.3",
			"typescript": "^7.0.2",
			"vite": "^8.3.2",
			"zod": "^4.6.5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"build:vercel": "bun scripts/vercel-build.ts",
		"lint": "biome check --error-on-warnings .",
		"check-types": "turbo run check-types",
		"test": "bun run test:agent-kit && turbo run test",
		"check": "bun run lint && bun run check-types && bun run test && bun run build",
		"check:fix": "biome check --write .",
		"dev:web": "turbo run dev -F web",
		"dev:server": "turbo run dev -F @blabla/backend",
		"dev:setup": "turbo run dev:setup -F @blabla/backend",
		"blabla": "dart run cli/bin/blabla.dart",
		"test:agent-kit": "tsc -p tsconfig.agent-kit.json && node --test tests/agent-kit-*.test.mjs"
	},
	"dependencies": {
		"@blabla/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@blabla/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.11.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=24.0.0",
		"bun": ">=1.4.2"
	}
}
